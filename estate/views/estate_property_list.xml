<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offers_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Offers" editable="top" decoration-danger="offer_status == 'refused'" decoration-success="offer_status == 'accepted'">
                <field name="name"/>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="offer_status" column_invisible="True"/>
                <button name="offer_confirmed" string="Confirm" type="object" icon="fa-check" invisible="offer_status != 'pending'"/>
                <button name="offer_refused" string="Reject" type="object" icon="fa-cancel" invisible="offer_status != 'pending'"/>
            </list>
        </field>
    </record>
</odoo>
