<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="awesome_gallery.GalleryController">
        <div t-att-class="props.className">
            <Layout display="display">
                <t t-component="props.Renderer"
                   data="model.data"
                   resModel="props.resModel"
                   imageField="props.imageField"
                   tooltipField="props.tooltipField"
                   tooltipTemplate="props.tooltipTemplate"
                   fieldsForTooltip="props.fieldsForTooltip"
                   onImageClick="(recordId) => this.switchToFormView(recordId)"
                   onImageUploaded="(recordId, base64) => this.onImageUploaded(recordId, base64)"/>
            </Layout>
        </div>
    </t>
</templates>
