<?xml version="1.0"?>
<odoo>

    <record id="test_model_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_view_custom_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="state" decoration-success="state in ('offer_received', 'offer_accepted')" decoration-bf="state == 'offer_accepted'" decoration-muted="state == 'sold'"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="true"/>
                <button name="delete_property" type="object" string="Delete" icon="fa-trash" invisible="state not in ('new', 'canceled')"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search by">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="facades"/>
                <filter string="States (New, Received)" name="state" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
                <group>
                    <filter string="Post Code" name="postcode" context="{'group_by':'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

     <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property" class="position-relative">
               <sheet>
                   <group>
                        <div>
                            <div class="d-flex justify-content-between align-items-center">
                                <h1 class="oe_title"><field name="name"/></h1>
                                <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold,canceled" />
                            </div>
                            <div class="container">
                                <div class="row">
                                    <div class="col">
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <div class="d-inline">
                                            <p class="fw-semibold d-inline">Postcode:</p>
                                            <p class="fw-normal"><field name="postcode"/></p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="d-inline">
                                            <p class="fw-semibold d-inline">Expected Price: </p>
                                            <p class="fw-normal"><field name="expected_price"/></p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="d-inline">
                                            <p class="fw-semibold d-inline">Best Price: </p>
                                            <p class="fw-normal"><field name="best_price"/></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <div class="d-inline">
                                            <p class="fw-semibold d-inline">Date Availability: </p>
                                            <p class="fw-normal"><field name="date_availability"/></p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="d-inline">
                                            <p class="fw-semibold d-inline">Selling Price: </p>
                                            <p class="fw-normal"><field name="selling_price"/></p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="d-inline">
                                            <p class="fw-semibold d-inline">Total Area: </p>
                                            <p class="fw-normal"><field name="total_area"/></p>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <p class="fw-semibold d-inline">Property Type: </p>
                                        <field name="property_type_id" options="{'no_create': True, 'no_edit': True}"/>
                                    </div>
                                    <div class="col">
                                        <div class="d-inline">
                                            <p class="fw-semibold d-inline">Validity: </p>
                                            <p class="fw-normal"><field name="validity"/></p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="d-inline">
                                            <p class="fw-semibold d-inline">Date Deadline: </p>
                                            <p class="fw-normal"><field name="date_deadline"/></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                   </group>
                   <notebook>
                        <page string="Description">
                            <div class="container">
                            <div class="row">
                                <div class="col-sm-2">
                                    <p class="fw-semibold">Status</p>
                                </div>
                                <div class="col-sm-10">
                                    <field name="status"/>
                                </div>
                            </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Bedrooms</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="bedrooms"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Living Area (sqm)</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="living_area"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Facades</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="facades"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">State</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="state" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Garage(s)</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="garage"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Garden</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="garden"/>
                                    </div>
                                </div>
                                <div class="row" invisible="not garden">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Garden Area (sqm)</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="garden_area"/>
                                    </div>
                                </div>
                                <div class="row" invisible="not garden">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Garden Orientation</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="garden_orientation"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Description</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="description"/>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state == 'offer_accepted' or state == 'sold' or state  ==  'canceled'">
                                <list string="Offers" editable="top" decoration-danger="status == 'refused'" decoration-success="status == 'accepted'">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="status" column_invisible="True"/>
                                    <button name="offer_confirmed" string="Confirm" type="object" icon="fa-check" invisible="status != 'pending'"/>
                                    <button name="offer_confirmed" string="Reject" type="object" icon="fa-cancel" invisible="status != 'pending'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other info">
                            <div class="container">
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Salesperson</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="salesperson"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-2">
                                        <p class="fw-semibold">Buyer</p>
                                    </div>
                                    <div class="col-sm-10">
                                        <field name="buyer"/>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                    <div class="d-flex justify-content-end pt-4 gap-2">
                        <button class="btn btn-warning" name="cancel_property" type="object" string="Cancel" invisible="status != 'pending'"/>
                        <button class="btn btn-success" name="sell_property" type="object" string="Sell" invisible="status != 'pending'"/>
                    </div>
               </sheet>
            </form>
        </field>
     </record>

</odoo>
