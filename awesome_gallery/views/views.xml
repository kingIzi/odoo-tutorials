<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Define the gallery view for res.partner -->
        <record id="res_partner_gallery_view" model="ir.ui.view">
            <field name="name">res.partner.gallery</field>
            <field name="model">res.partner</field>
            <field name="type">gallery</field>
            <field name="arch" type="xml">
                <gallery image_field="image_1920" tooltip_field="name">
                    <field name="email"/>
                    <field name="name"/>
                    <tooltip-template>
                        <p class="m-0">name: <field name="name"/></p>
                        <p class="m-0">e-mail: <field name="email"/></p>
                    </tooltip-template>
                </gallery>
            </field>
        </record>

        <!-- Override the contacts action to include gallery as first view mode -->
        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="name">Contacts</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">gallery,kanban,list,form,activity</field>
            <field name="search_view_id" ref="base.view_res_partner_filter"/>
            <field name="context">{'default_is_company': True}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Contact in your address book
              </p><p>
                Odoo helps you track all activities related to your contacts.
              </p>
            </field>
        </record>
    </data>
</odoo>
